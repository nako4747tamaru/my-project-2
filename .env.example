# ==========================================
# ココロナビ (Kokoro Navi) 環境変数設定例
# ==========================================

# Google AdSense 審査・配信設定
# Google AdSense 管理画面で発行されたパブリッシャーIDを入力してください。
# 設定されていない場合は審査タグは出力されず、プレースホルダー枠のみが表示されます。
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Stripe 決済設定（有料プラン用）
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
