# ==========================================
# ココロナビ (Kokoro Navi) 環境変数設定例
# ==========================================

# Google AdSense 審査・配信設定
# Google AdSense 管理画面で発行されたパブリッシャーIDを入力してください。
# 設定されていない場合は審査タグは出力されず、プレースホルダー枠のみが表示されます。
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Stripe 決済設定（有料プラン完全レポート解放・定期課金用）
# Stripeダッシュボード (Developers > API keys) から取得した秘密鍵を設定してください。
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe 商品価格 ID (任意: 設定時は Stripe の登録済み Price を優先適用)
# 未指定の場合は、月額980円のサブスクリプション商品がAPIから自動作成・適用されます。
# STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXXXXX

# 決済モード (subscription または payment: デフォルトは subscription)
# STRIPE_MODE=subscription

# アプリケーションのベースURL（本番用、未指定時はリクエストヘッダーから自動判定）
# NEXT_PUBLIC_APP_URL=https://kokoronavi.dev
