# ==========================================
# ココロナビ (Kokoro Navi) 環境変数設定例
# ==========================================

# Google AdSense 審査・配信設定
# Google AdSense 管理画面で発行されたパブリッシャーIDを入力してください。
# 設定されていない場合は審査タグは出力されず、プレースホルダー枠のみが表示されます。
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2111086731004371

# Stripe 決済設定（有料プラン完全レポート解放・定期課金用）
# Stripeダッシュボード (Developers > API keys) から取得した秘密鍵を設定してください。
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Webhook 署名シークレット (Developers > Webhooks で作成)
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Stripe 商品価格 ID (任意: 設定時は Stripe の登録済み Price を優先適用)
# 未指定の場合は、月額980円のサブスクリプション商品がAPIから自動作成・適用されます。
# STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXXXXX

# 決済モード (subscription または payment: デフォルトは subscription)
# STRIPE_MODE=subscription

# ソーシャルログイン (OAuth 2.0) 設定
# 1. Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 2. X (Twitter) Developer Portal (User authentication settings)
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# 3. Apple Developer (Sign in with Apple)
APPLE_CLIENT_ID=com.kokoronavi.web.service
APPLE_CLIENT_SECRET=your_apple_client_secret

# メール送信 (SMTP) 設定（サンクスメール・領収メール送信用）
# 未設定時はコンソールログおよびモックシミュレーションモードとして動作します。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ココロナビ <no-reply@kokoronavi.dev>"

# 認証トークン暗号化シークレットキー（ランダムな英数字文字列）
AUTH_SECRET=kokoro-navi-super-secure-auth-secret-key-2026

# アプリケーションのベースURL（本番用、未指定時はリクエストヘッダーから自動判定）
# NEXT_PUBLIC_APP_URL=https://kokoronavi.dev
